{
  "name": "atlas-lms",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas LMS: an open-source learning management system built around teacher-governed AI, assessed work sessions, and evidence-backed grading.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prashant002-1/Atlas-LMS.git"
  },
  "homepage": "https://github.com/Prashant002-1/Atlas-LMS#readme",
  "bugs": {
    "url": "https://github.com/Prashant002-1/Atlas-LMS/issues"
  },
  "type": "module",
  "scripts": {
    "fonts": "node scripts/decode-fonts.mjs",
    "predev": "npm run fonts && npm run local:check",
    "dev": "next dev",
    "prebuild": "npm run fonts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/workspace/*.test.ts lib/course/*.test.ts lib/db/fixtures/*.test.ts lib/auth/*.test.ts lib/agent/*.test.ts lib/code-execution/*.test.ts lib/instructor/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:workflow": "tsx scripts/smoke-workflow.ts",
    "smoke:code-execution": "tsx scripts/agentcore-smoke.ts",
    "smoke:code-execution-db": "node --env-file-if-exists=.env.local --import tsx scripts/code-execution-db-smoke.ts",
    "regrade": "tsx scripts/regrade.ts",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "npm run db:upgrade",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx lib/db/seed.ts",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/db-release.ts check",
    "db:upgrade": "node --env-file-if-exists=.env.local --import tsx scripts/db-release.ts upgrade",
    "local:check": "node --env-file-if-exists=.env.local --import tsx scripts/local-readiness.ts",
    "documents:reingest-seed": "node --env-file-if-exists=.env.local --import tsx scripts/reingest-seed-documents.ts",
    "workflow:bootstrap": "node --env-file-if-exists=.env.local node_modules/@workflow/world-postgres/bin/setup.js",
    "postinstall": "npm run fonts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.20",
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/react": "^4.0.40",
    "@ai-sdk/workflow": "^1.0.70",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-bedrock-agentcore": "^3.1111.0",
    "@firecrawl/anydoc": "0.1.7",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@workflow/world-postgres": "^4.3.10",
    "ai": "^7.0.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.34.3",
    "lucide-react": "^1.61.0",
    "motion": "^12.42.2",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "workflow": "^4.8.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "chokidar": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "@workflow/core": {
      "nanoid": "5.1.16",
      "devalue": "5.9.4"
    },
    "fast-uri": "3.1.8",
    "qs": "6.16.0",
    "@ai-sdk/workflow": {
      "ai": "$ai",
      "@ai-sdk/provider": ">=4.0.7",
      "@ai-sdk/provider-utils": ">=5.0.27"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
