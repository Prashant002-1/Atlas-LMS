# ─────────────────────────────────────────────────────────────
# Atlas LMS — environment
# Copy to .env.local for dev:  cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# Postgres 16 + pgvector. The docker-compose `db` service matches these creds.
DATABASE_URL="postgres://atlas:atlas@localhost:5432/atlas"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Public base URL of the app (used for callbacks).
AUTH_URL="http://localhost:3000"

# ── Model provider ───────────────────────────────────────────
# Atlas is provider-abstracted (see lib/ai/provider.ts). Set ONE of the following.
# Default path is OpenRouter (BYOK), but use a real (paid) model — not a :free tier.
OPENROUTER_API_KEY=""
# Optional direct OpenAI key (used for embeddings by default).
OPENAI_API_KEY=""

# Override the default model ids if desired (see provider.ts for fallbacks).
ATLAS_CHAT_MODEL="openai/gpt-4.1"
ATLAS_STRUCTURED_MODEL="openai/gpt-4.1"
ATLAS_EMBEDDING_MODEL="text-embedding-3-small"   # 1536 dims — pgvector-indexable

# ── Canvas import (the migration wedge — optional) ───────────
# Per-user tokens are stored encrypted in DB in production; these are dev fallbacks.
CANVAS_BASE_URL=""
CANVAS_TOKEN=""

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV="development"
