# Atlas LMS environment
# Copy to .env.local for development.

DATABASE_URL="postgres://atlas:atlas@localhost:5432/atlas"

# Auth.js
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"

# Chat and generation provider
# Atlas platform operators own provider configuration as server secrets.
# Teacher and student routes never expose or override providers, models,
# endpoints, or credentials.
#   openrouter | openai | anthropic | google | openai_compatible
ATLAS_CHAT_PROVIDER="openai_compatible"
ATLAS_CHAT_MODEL="anthropic/claude-sonnet-4"
ATLAS_STRUCTURED_MODEL="anthropic/claude-sonnet-4"
ATLAS_FALLBACK_PROVIDER="openai_compatible"
ATLAS_FALLBACK_MODEL="anthropic/claude-haiku-4"

ATLAS_OPENAI_COMPAT_BASE_URL="http://127.0.0.1:4096/v1"
ATLAS_OPENAI_COMPAT_API_KEY=""

OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional server-owned public source access. Atlas exposes no user setting for this key.
EXA_API_KEY=""

# Voice transcription only. This does not change Atlas's chat model.
ATLAS_TRANSCRIPTION_MODEL="gemini-3.6-flash"

# Native opencode session API, experimental.
OPENCODE_BASE_URL=""
OPENCODE_SERVER_USERNAME=""
OPENCODE_SERVER_PASSWORD=""

# Course-content embeddings
ATLAS_EMBEDDING_PROVIDER="google"
ATLAS_EMBEDDING_MODEL="gemini-embedding-002"
ATLAS_EMBEDDING_DIMS="1536"
ATLAS_EMBED_MIN_CHARS="280"
GEMINI_API_KEY=""

# Course material ingestion
# The web process forwards bounded uploads and HTTPS links to this institution
# service. It returns a durable object URL plus optional extracted text, page
# count, metadata, processing state, and a stable job id. Atlas never stores
# uploaded bytes on the ephemeral application filesystem. Use separate secrets
# for outbound service authentication and HMAC-signed callbacks. Set the public
# app URL when AUTH_URL is not the externally reachable callback origin.
ATLAS_MATERIAL_INGEST_URL=""
ATLAS_MATERIAL_INGEST_TOKEN=""
ATLAS_MATERIAL_CALLBACK_SECRET=""
ATLAS_PUBLIC_APP_URL=""

# Canvas import, optional
CANVAS_BASE_URL=""
CANVAS_TOKEN=""

NODE_ENV="development"
