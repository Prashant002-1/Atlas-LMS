{
  "name": "atlas-lms",
  "version": "0.1.0",
  "private": true,
  "description": "Course record for teaching and study.",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/decode-fonts.mjs",
    "predev": "npm run fonts",
    "dev": "next dev",
    "prebuild": "npm run fonts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/workspace/*.test.ts lib/db/fixtures/*.test.ts lib/agent/*.test.ts lib/instructor/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "regrade": "tsx scripts/regrade.ts",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx lib/db/seed.ts",
    "postinstall": "npm run fonts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.7",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/openai": "^4.0.7",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@ai-sdk/react": "^4.0.18",
    "@ai-sdk/workflow": "^1.0.14",
    "@auth/drizzle-adapter": "^1.10.0",
    "ai": "^7.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.18.0",
    "pgvector": "^0.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "workflow": "^4.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.21",
      "sharp": "0.35.3"
    },
    "fast-uri": "3.1.4"
  },
  "engines": {
    "node": ">=24"
  }
}
