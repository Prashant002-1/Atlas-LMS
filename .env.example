# ─────────────────────────────────────────────────────────────
# Atlas LMS — environment
# Copy to .env.local for dev:  cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# Postgres 16 + pgvector. The docker-compose `db` service matches these creds.
DATABASE_URL="postgres://atlas:atlas@localhost:5432/atlas"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Public base URL of the app (used for callbacks).
AUTH_URL="http://localhost:3000"

# ── Chat / generation provider ───────────────────────────────
# Atlas resolves models through a registry (lib/ai/provider.ts). Pick the chat
# provider, then set that provider's key below. BYOK org keys (Course settings)
# override env. Use real (paid) models, not :free tiers.
#   openrouter | openai | anthropic | google | openai_compatible
ATLAS_CHAT_PROVIDER="openai_compatible"
# Model id AS THE CHOSEN PROVIDER NAMES IT (e.g. "openai/gpt-4.1" for openrouter,
# "gpt-4.1" for openai, "claude-3-7-sonnet-latest" for anthropic,
# "gemini-2.5-pro" for google, or whatever your gateway exposes).
ATLAS_CHAT_MODEL="anthropic/claude-sonnet-4"
ATLAS_STRUCTURED_MODEL="anthropic/claude-sonnet-4"
# Cheaper/more-available model for compaction + retries.
ATLAS_FALLBACK_PROVIDER="openai_compatible"
ATLAS_FALLBACK_MODEL="anthropic/claude-haiku-4"

# opencode for chat/generation (the intended default): run `opencode serve` and
# front it with an OpenAI-compatible gateway, then point the compat slot at it.
# Any OpenAI-compatible server works here (LiteLLM, vLLM, LM Studio, a gateway).
ATLAS_OPENAI_COMPAT_BASE_URL="http://127.0.0.1:4096/v1"
ATLAS_OPENAI_COMPAT_API_KEY=""

# Per-provider keys (set the one matching ATLAS_CHAT_PROVIDER; others optional).
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# @ai-sdk/google reads GOOGLE_GENERATIVE_AI_API_KEY (GEMINI_API_KEY also accepted).
GOOGLE_GENERATIVE_AI_API_KEY=""

# Native opencode session API (EXPERIMENTAL, lib/ai/opencode.ts). Only needed if
# you call opencode's own agent loop directly instead of via the compat gateway.
OPENCODE_BASE_URL=""
OPENCODE_SERVER_USERNAME=""
OPENCODE_SERVER_PASSWORD=""

# ── Embeddings (course-content lookup ONLY, never session recall) ─────
# Session recall is keyword FTS (no model). Embeddings are reserved for semantic
# lookup over large content (syllabus, long pages). Output is pinned to 1536 dims
# so vectors fit the existing pgvector columns and stay HNSW-indexable (ADR-004).
#   provider: google | openai | openai_compatible
ATLAS_EMBEDDING_PROVIDER="google"
ATLAS_EMBEDDING_MODEL="gemini-embedding-002"
ATLAS_EMBEDDING_DIMS="1536"
# Only content at least this many chars is embedded; shorter stays in the pack.
ATLAS_EMBED_MIN_CHARS="280"
# Google embeddings key (falls back to GOOGLE_GENERATIVE_AI_API_KEY).
GEMINI_API_KEY=""

# ── Canvas import (the migration wedge — optional) ───────────
# Per-user tokens are stored encrypted in DB in production; these are dev fallbacks.
CANVAS_BASE_URL=""
CANVAS_TOKEN=""

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV="development"
